; main.art

print "============================================="
print " 🍕 Munchies Arturo Backend Server Framework"
print "============================================="

; 1. Load configuration cleanly using the native .toml read flag
config: read.toml ".env"
serverPort: config\PORT

print ["● Environment Status: Local Development Ready"]
print ["● Database Hooked to: " config\DB_NAME]
print ["🚀 Launching active HTTP engine on port:" serverPort]
print "---------------------------------------------"

; 2. Initialize the native web server engine
; Load the route definitions once at startup
do "routes/api.art"

serve.port: serverPort [request][
    handleRequest request
]